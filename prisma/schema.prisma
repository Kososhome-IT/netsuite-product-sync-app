// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
 
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

model DashboardLog {
  id               Int      @id @default(autoincrement())
  shop             String?
  netsuiteUser     String?  @map("netsuite_user")
  productSku       String?  @map("product_sku")
  shopifyProductId String?  @map("shopify_product_id")
  productName      String?  @map("product_name")
  action           String?
  status           String?
  errorStage       String?  @map("error_stage")
  errorMessage     String?  @map("error_message")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @map("updated_at")

  @@map("dashboard_logs")
}


model ProductSyncLog {
  id               Int      @id @default(autoincrement())
  sku              String
  action           String?  // created | updated
  status           String   // PROCESSING | SUCCESS | FAILED | SKIPPED
  productId        String?
  variantId        String?
  inventoryItemId  String?
  title            String?
  payload          Json?
  error            Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([sku, status])
  @@index([createdAt])
}

enum InventoryLogStatus {
  SUCCESS
  FAILED
}

model InventoryLog {
  id              String   @id @default(uuid())
  sku             String
  warehouse       String
  locationId      String
  quantity        Int
  status          InventoryLogStatus
  errorMessage    String?
  source          String
  requestPayload  Json?
  responsePayload Json?
  createdAt       DateTime @default(now())

  @@index([sku])
  @@index([status])
  @@index([createdAt])
}
